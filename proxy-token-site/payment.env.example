# Copy these values into a host-only mode-0600 environment file.
# Never commit live keys.

PAYMENT_PUBLIC_BASE_URL=https://leandata.uk

# ZPay / EasyPay (implementation remains disabled until the merchant is approved)
# Keep the Alipay tile visible but non-payable until EasyPay approves the account.
PAYMENT_ALIPAY_ENABLED=false
PAYMENT_WECHAT_ENABLED=false
EASYPAY_API_BASE_URL=
EASYPAY_PID=
EASYPAY_PKEY=
EASYPAY_ALIPAY_CHANNEL_ID=

# Stripe Checkout
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# USD-anchored card pricing: USD monthly amounts are the source of truth;
# CAD is derived as round(USD * USD->CAD rate), fetched dynamically from a
# free FX source and cached for FX_CACHE_TTL_MS (default 12h). CNY pricing is
# independent and never derived from this rate.
# Pin a rate for testing or freeze it during an incident:
# USD_CAD_RATE_OVERRIDE=
# Fallback rate when the live fetch fails and nothing was cached (default 1.2):
# USD_CAD_FALLBACK_RATE=1.2
# FX cache TTL in milliseconds (default 43200000 = 12h):
# FX_CACHE_TTL_MS=43200000

# Local development only. Never enable in production.
PAYMENT_MOCK_ENABLED=false
