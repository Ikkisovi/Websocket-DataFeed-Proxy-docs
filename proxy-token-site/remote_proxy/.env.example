# Alpaca Master Key (used by ThinkCentre REST proxy and as fallback for EC2)
ALPACA_MASTER_KEY=your_master_key_here
ALPACA_MASTER_SECRET=your_master_secret_here

# Alpaca Free Keys (5 pairs, used by EC2 WS proxy for key pool rotation)
ALPACA_FREE_KEY_1=
ALPACA_FREE_SECRET_1=
ALPACA_FREE_KEY_2=
ALPACA_FREE_SECRET_2=
ALPACA_FREE_KEY_3=
ALPACA_FREE_SECRET_3=
ALPACA_FREE_KEY_4=
ALPACA_FREE_SECRET_4=
ALPACA_FREE_KEY_5=
ALPACA_FREE_SECRET_5=

# TimescaleDB
TIMESCALEDB_PASSWORD=your_db_password_here
